.page {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 40rpx 0;
  min-height: 100vh;
  box-sizing: border-box;
  background: linear-gradient(180deg, #fef9f0 0%, #f8f4ed 40%, #f3efe8 100%);
}

/* 店铺名称 */
.shop-name {
  font-size: 48rpx;
  font-weight: 700;
  color: #2c2416;
  letter-spacing: 6rpx;
  margin-bottom: 16rpx;
}
.shop-slogan {
  font-size: 26rpx;
  color: #b8a082;
  letter-spacing: 2rpx;
  margin-bottom: 20rpx;
}

/* 店铺描述 */
.shop-desc {
  font-size: 24rpx;
  color: #9b8c7c;
  text-align: center;
  max-width: 520rpx;
  line-height: 2;
  margin-bottom: 24rpx;
  background: rgba(255, 255, 255, 0.5);
  padding: 20rpx 32rpx;
  border-radius: 16rpx;
}

/* 装饰图 */
.deco-img {
  width: calc(100% + 80rpx);
  border-radius: 20rpx;
  margin-bottom: 36rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.06);
}

/* 营业信息 */
.info-row {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 56rpx;
}
.info-item {
  font-size: 24rpx;
  color: #b8a082;
  letter-spacing: 1rpx;
}

/* 按钮 */
.actions {
  width: 100%;
  display: flex;
  flex-direction: column;
  margin-bottom: auto;
}
.actions button {
  font-size: 32rpx;
  text-align: center;
  padding: 28rpx;
  border: none;
}
.btn-primary {
  background: linear-gradient(135deg, #e6532e 0%, #d4421e 100%);
  color: #fff;
  border-radius: 100rpx;
  box-shadow: 0 10rpx 28rpx rgba(230, 83, 46, 0.25);
  margin-bottom: 24rpx;
  font-weight: 500;
  letter-spacing: 2rpx;
}
.btn-order {
  background: rgba(230, 83, 46, 0.06);
  color: #c44a28;
  font-size: 28rpx;
  padding: 20rpx;
  margin-bottom: 4rpx;
  border-radius: 100rpx;
}

/* 页脚 */
.footer {
  color: #d6cdbf;
  font-size: 22rpx;
  letter-spacing: 2rpx;
  padding: 48rpx 0 calc(48rpx + env(safe-area-inset-bottom));
}

