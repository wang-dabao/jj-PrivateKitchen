.page { min-height: 100vh; }
.category-bar { white-space: nowrap; padding: 10rpx 20rpx; background: #fff; flex-shrink: 0; }
.cat-tab { display: inline-flex; align-items: center; padding: 16rpx 28rpx; font-size: 26rpx; color: var(--color-text-light); transition: transform 0.15s ease, opacity 0.15s ease; }
.cat-tab.active { color: var(--color-primary); font-weight: bold; }
.cat-tab.add { color: var(--color-primary); }
.dish-list { padding: 20rpx; min-height: 300rpx; }
.dish-row { display: flex; align-items: center; background: #fff; padding: 24rpx; border-radius: 12rpx; margin-bottom: 12rpx; }
.dish-name { flex: 1; font-size: 28rpx; margin-right: 16rpx; }
.dish-price { font-size: 28rpx; margin-right: 16rpx; }
.dish-status { font-size: 22rpx; color: #4caf50; margin-right: 16rpx; }
.dish-status.off { color: var(--color-text-light); }
.row-actions { display: flex; }
.row-actions text { font-size: 22rpx; color: var(--color-primary); margin-right: 16rpx; }
.add-dish-btn { text-align: center; padding: 30rpx; color: var(--color-primary); font-size: 28rpx; border: 2rpx dashed var(--color-primary); border-radius: 12rpx; }
.modal-mask { position: fixed; top: 0; right: 0; bottom: 0; left: 0; background: rgba(0,0,0,0.5); z-index: 100; }
.modal { position: fixed; top: 0; right: 0; bottom: 0; left: 0; z-index: 101; display: flex; align-items: center; justify-content: center; }
.modal-content { background: #fff; border-radius: 24rpx; padding: 40rpx; width: 600rpx; }
.modal-title { display: block; font-size: 32rpx; font-weight: bold; text-align: center; margin-bottom: 30rpx; }
.modal-input { width: 100%; padding: 20rpx; background: var(--color-bg); border-radius: 12rpx; font-size: 28rpx; margin-bottom: 20rpx; }
.modal-btns { display: flex; }
.modal-btn { flex: 1; padding: 20rpx; border-radius: 12rpx; font-size: 28rpx; text-align: center; border: none; }
.modal-btn.cancel { background: var(--color-bg); margin-right: 20rpx; }
.modal-btn.confirm { background: var(--color-primary); color: #fff; }
.images-grid { display: flex; flex-wrap: wrap; margin-bottom: 20rpx; }
.grid-img-wrap { width: 180rpx; height: 180rpx; border-radius: 12rpx; margin-right: 16rpx; margin-bottom: 16rpx; position: relative; }
.grid-img { width: 100%; height: 100%; border-radius: 12rpx; }
.grid-img-del { position: absolute; top: 4rpx; right: 4rpx; width: 40rpx; height: 40rpx; border-radius: 50%; background: rgba(0,0,0,0.5); color: #fff; font-size: 28rpx; text-align: center; line-height: 38rpx; }
.grid-add { width: 180rpx; height: 180rpx; border-radius: 12rpx; background: var(--color-bg); display: flex; flex-direction: column; align-items: center; justify-content: center; }
.upload-icon { font-size: 56rpx; color: var(--color-text-light); }
.upload-text { font-size: 22rpx; color: var(--color-text-light); }
.upload-hint { display: block; font-size: 22rpx; color: var(--color-primary); margin-bottom: 16rpx; }
.modal-picker { margin-bottom: 20rpx; }
.picker-display { width: 100%; padding: 20rpx; background: var(--color-bg); border-radius: 12rpx; font-size: 28rpx; color: var(--color-text); }
