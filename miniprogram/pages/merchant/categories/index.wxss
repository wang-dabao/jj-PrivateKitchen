.page { display: flex; flex-direction: column; height: 100vh; }

.list { flex: 1; padding: 20rpx; }

.cat-row {
  display: flex;
  align-items: center;
  background: #fff;
  padding: 28rpx 24rpx;
  border-radius: 12rpx;
  margin-bottom: 12rpx;
  transition: transform 0.15s ease, opacity 0.15s ease;
}
.cat-row.dragging { opacity: 0.3; }
.cat-row.drag-over { transform: scale(1.02); }

.drag-handle { display: flex; flex-direction: column; gap: 6rpx; margin-right: 20rpx; padding: 8rpx; }
.handle-bar { display: block; width: 32rpx; height: 4rpx; background: #ccc; border-radius: 2rpx; }

.cat-name { flex: 1; font-size: 30rpx; }

.row-actions { display: flex; align-items: center; }
.row-actions text { font-size: 24rpx; color: var(--color-primary); margin-left: 24rpx; }

.sort-btns {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin-right: 12rpx;
  width: 64rpx;
  height: 100rpx;
  flex-shrink: 0;
}
.sort-arrow {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  font-size: 28rpx;
  color: var(--color-primary);
}
.sort-arrow.disabled { color: #ddd; }

.empty { text-align: center; color: var(--color-text-light); padding: 100rpx 0; }

.footer { padding: 20rpx; }
.add-btn { width: 100%; background: var(--color-primary); color: #fff; border-radius: 12rpx; padding: 24rpx; font-size: 30rpx; border: none; }

/* Drag float */
.drag-float {
  position: fixed;
  left: 20rpx;
  right: 20rpx;
  z-index: 201;
  display: flex;
  align-items: center;
  background: var(--color-primary);
  color: #fff;
  padding: 28rpx 24rpx;
  border-radius: 12rpx;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.3);
  pointer-events: none;
}
.drag-float .handle-bar { background: rgba(255,255,255,0.5); }

/* Modal */
.modal-mask { position: fixed; top: 0; right: 0; bottom: 0; left: 0; background: rgba(0,0,0,0.5); z-index: 100; }
.modal { position: fixed; top: 0; right: 0; bottom: 0; left: 0; z-index: 101; display: flex; align-items: center; justify-content: center; }
.modal-content { background: #fff; border-radius: 24rpx; padding: 40rpx; width: 600rpx; }
.modal-title { display: block; font-size: 32rpx; font-weight: bold; text-align: center; margin-bottom: 30rpx; }
.modal-input { width: 100%; padding: 20rpx; background: var(--color-bg); border-radius: 12rpx; font-size: 28rpx; margin-bottom: 20rpx; }
.modal-btns { display: flex; }
.modal-btn { flex: 1; padding: 20rpx; border-radius: 12rpx; font-size: 28rpx; text-align: center; border: none; }
.modal-btn.cancel { background: var(--color-bg); margin-right: 20rpx; }
.modal-btn.confirm { background: var(--color-primary); color: #fff; }
